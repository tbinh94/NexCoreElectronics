{
    "name": "next-gen-ecommerce-root",
    "private": true,
    "workspaces": [
        "frontend",
        "backend"
    ],
    "scripts": {
        "build": "yarn --cwd backend install",
        "start": "yarn --cwd backend start",
        "dev": "concurrently \"yarn --cwd backend dev\" \"yarn --cwd frontend dev\"",
        "install:all": "yarn --cwd backend install && yarn --cwd frontend install"
    },
    "devDependencies": {
        "concurrently": "^9.1.0"
    }
}